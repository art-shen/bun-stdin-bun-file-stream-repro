{
  "name": "bun-stdin-bun-file-stream-repro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings --import-plugin --node-plugin --promise-plugin --type-aware",
    "repro": "bun run-matrix.ts",
    "repro:assert-fixed": "bun run-matrix.ts --assert-fixed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.7.0",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3"
  }
}
